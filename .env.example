# ────────────────────────────────────────────────────────────────
# Tour Upload Hub — environment variables
# Copy this file to `.env` for local development and fill in values.
# NEVER commit the real `.env` file to GitHub.
# ────────────────────────────────────────────────────────────────

# Port the web server listens on (Railway provides PORT automatically).
PORT=3000

# Public HTTPS URL of the deployed site (used for the admin QR code).
# Example: https://my-tour.up.railway.app
PUBLIC_SITE_URL=

# ── Google Drive (required) ─────────────────────────────────────
# The ID of the Google Drive folder every file is uploaded into.
# Get it from the folder URL: https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Recommended: paste the complete one-line service-account JSON key here, then
# share the destination Drive folder with that key's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative legacy OAuth credentials (not needed when service account JSON is set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: OAuth scope. Default full Drive access on YOUR account so any
# folder you own works out of the box. Do NOT use "drive.file" with a folder
# you created manually in the Drive web UI (the API returns "file not found").
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# ── Admin (required) ────────────────────────────────────────────
# Password for the /admin dashboard (choose a long, strong password).
ADMIN_PASSWORD=

# ── Optional shared PIN for participants ───────────────────────
# If set (non-empty), visitors must enter this PIN before they can upload.
# Leave empty to allow anyone with the link to upload.
TOUR_UPLOAD_PIN=

# ── Feature toggles ─────────────────────────────────────────────
# Set to false to fully disable the public gallery route.
ENABLE_GALLERY=true
# Default values (can be toggled live from the admin dashboard):
# ENABLE_UPLOADS=true
# GALLERY_VISIBLE=true

# ── Limits ──────────────────────────────────────────────────────
# Maximum size of a single file in megabytes (default 2048 = 2 GB).
MAX_FILE_SIZE_MB=2048
# Maximum number of files a visitor may select in one batch.
MAX_FILES_PER_UPLOAD=50
# Resumable upload chunk size in megabytes (leave default unless you know why).
UPLOAD_CHUNK_MB=8
# How many most-recent files the gallery shows (max listed at once).
GALLERY_LIMIT=300

# ── Abuse protection (uploads, all optional) ───────────────────
# Max in-flight upload sessions the whole server accepts at once.
# New sessions beyond this get HTTP 503 { error: "UPLOAD_CAPACITY" }.
MAX_ACTIVE_UPLOADS=150
# Max simultaneous in-flight upload sessions a single IP may hold.
# Excess attempts get HTTP 429 { error: "TOO_MANY_UPLOADS" }.
MAX_UPLOADS_PER_IP=40
# Max NEW Drive resumable sessions created per IP inside a 60 s window.
# Excess attempts get HTTP 429 { error: "RATE_LIMITED" }.
MAX_SESSION_CREATES_PER_MIN_PER_IP=60
# After this many minutes without progress an upload session is aborted and
# its filename reservation released.
UPLOAD_SESSION_IDLE_MINUTES=120

# ── PIN-protected gallery media URLs ───────────────────────────
# When TOUR_UPLOAD_PIN is set, the gallery mints short-lived signed media URLs.
# This is their lifetime in hours (media <img>/<video> can't send headers, so
# the signed token travels in the URL query — keep it short).
GALLERY_TOKEN_TTL_HOURS=3

# ── Tour page content (all optional) ────────────────────────────
# These are only the DEFAULT values — the admin can change all of them live
# from /admin → "Tour page & Drive folders" (saved in data/site.json), and can
# also rename the upload categories & their Drive folders there.
TOUR_TITLE=Tour Memories
TOUR_SUBTITLE=আমাদের Tour-এর সব ছবি ও ভিডিও এখানে Upload করুন
# TOUR_DATE=12–15 September 2026
# TOUR_LOCATION=Cox's Bazar, Bangladesh
# TOUR_COVER_URL=https://example.com/cover.jpg
# TOUR_PRIVACY_NOTE=আপনার Upload করা ফাইল শুধু আমাদের Tour Drive-এ সংরক্ষিত হবে।

# ── Misc ────────────────────────────────────────────────────────
# NODE_ENV=production
